NODE_ENV=development

# REST gateway
GATEWAY_REST_HOST=127.0.0.1
GATEWAY_REST_PORT=3000

# Sample TCP microservice — in Docker use container names (ms-nestjs-items)
ITEMS_MICROSERVICE_HOST=127.0.0.1
ITEMS_MICROSERVICE_PORT=3001

# MongoDB
MONGO_URL=mongodb://root:root@127.0.0.1:27017/?authMechanism=DEFAULT
MONGO_DB_NAME=microserviceNestjs

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Optional Loki (leave empty to disable)
LOKI_URL=
LOKI_ENABLED=false
