{
    "name": "microservice-nestjs",
    "version": "0.0.1",
    "description": "NestJS TCP microservices + REST gateway template",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "build:watch:gateway:rest": "nest build gateway-rest --watch",
        "build:watch:items": "nest build items --watch",
        "format": "prettier --write \"apps/**/*.ts\" \"common/**/*.ts\" \"tests/**/*.ts\"",
        "start": "nest start",
        "start:dev:gateway:rest": "nest start gateway-rest --watch",
        "start:dev:items": "nest start items --watch",
        "start:debug:gateway:rest": "nest start gateway-rest --watch --debug",
        "start:debug:items": "nest start items --watch --debug",
        "start:prod:gateway:rest": "node dist/apps/gateway-rest/main",
        "start:prod:items": "node dist/apps/items/main",
        "lint": "eslint \"{src,apps,libs,tests,common}/**/*.ts\" --fix",
        "pretest": "make test-deps",
        "test": "NODE_ENV=test node --expose-gc ./node_modules/.bin/jest --config=jest.config.ts --runInBand --no-compilation-cache --clearMocks",
        "posttest": "make test-deps-down",
        "test:watch": "NODE_ENV=test jest --watch --runInBand --testTimeout 60000",
        "test:cov": "NODE_ENV=test jest --coverage --runInBand --testTimeout 60000"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.14",
        "@nestjs/core": "^11.1.14",
        "@nestjs/microservices": "^11.1.14",
        "@nestjs/mongoose": "^11.0.4",
        "@nestjs/platform-express": "^11.1.14",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "dotenv": "^17.3.1",
        "mongoose": "^9.2.2",
        "mongoose-hidden": "^1.9.1",
        "nest-winston": "^1.10.2",
        "qs": "^6.14.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "winston": "^3.19.0",
        "winston-loki": "^6.1.4"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.4",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.14",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.3.0",
        "@types/qs": "^6.14.0",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.3.0",
        "jest": "^30.2.0",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}
